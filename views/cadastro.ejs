<%- include('partials/header', { titulo: 'Cadastro' }) %>

<div style="max-width: 400px;" class="mx-auto">
  <h2>Cadastro</h2>
  <% if (erro) { %><div class="alert alert-danger"><%= erro %></div><% } %>
  <form method="POST" action="/cadastro">
    <input class="form-control mb-2" type="text" name="nome" placeholder="Nome" required>
    <input class="form-control mb-2" type="email" name="email" placeholder="E-mail" required>
    <input class="form-control mb-2" type="password" name="senha" placeholder="Senha" required>
    <button class="btn btn-success w-100">Cadastrar</button>
  </form>
  <p class="mt-3"><a href="/login">Já tenho conta</a></p>
</div>

<%- include('partials/footer') %>