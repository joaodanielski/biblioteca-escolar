<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5" style="max-width: 400px;">
  <h2>Login</h2>
  <% if (erro) { %><div class="alert alert-danger"><%= erro %></div><% } %>
  <form method="POST" action="/login">
    <input class="form-control mb-2" type="email" name="email" placeholder="E-mail" required>
    <input class="form-control mb-2" type="password" name="senha" placeholder="Senha" required>
    <button class="btn btn-primary w-100">Entrar</button>
  </form>
  <p class="mt-3"><a href="/cadastro">Criar conta</a></p>
</body>
</html>