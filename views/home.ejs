<%- include('partials/header', { titulo: 'Início' }) %>

<h2>Bem-vindo(a), <%= usuario.nome %>!</h2>

<% if (usuario.perfil === 'admin') { %>
  <p>Você pode gerenciar usuários, livros, autores, categorias e empréstimos.</p>
<% } else if (usuario.perfil === 'bibliotecario') { %>
  <p>Você pode gerenciar livros, autores, categorias e empréstimos.</p>
<% } else { %>
  <p>Você pode consultar os livros e ver seus empréstimos.</p>
<% } %>

<%- include('partials/footer') %>