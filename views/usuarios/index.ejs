<%- include('../partials/header', { titulo: 'Usuários' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Usuários</h2>
  <a href="/usuarios/novo" class="btn btn-primary">Novo usuário</a>
</div>

<table class="table table-striped">
  <thead>
    <tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Ações</th></tr>
  </thead>
  <tbody>
    <% usuarios.forEach(u => { %>
      <tr>
        <td><%= u.nome %></td>
        <td><%= u.email %></td>
        <td><%= u.perfil %></td>
        <td class="d-flex gap-2">
          <a href="/usuarios/<%= u.id %>/editar" class="btn btn-sm btn-warning">Editar</a>
          <form method="POST" action="/usuarios/<%= u.id %>?_method=DELETE"
                onsubmit="return confirm('Excluir este usuário?')">
            <button class="btn btn-sm btn-danger">Excluir</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>