<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof titulo !== 'undefined' ? titulo : 'Biblioteca Escolar' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<% if (locals.usuario) { %>
<nav class="navbar navbar-expand navbar-dark bg-dark px-3">
  <a class="navbar-brand" href="/">Biblioteca</a>
  <ul class="navbar-nav me-auto">
    <li class="nav-item"><a class="nav-link" href="/livros">Livros</a></li>

    <% if (['admin', 'bibliotecario'].includes(usuario.perfil)) { %>
      <li class="nav-item"><a class="nav-link" href="/autores">Autores</a></li>
      <li class="nav-item"><a class="nav-link" href="/categorias">Categorias</a></li>
    <% } %>

    <li class="nav-item"><a class="nav-link" href="/emprestimos">Empréstimos</a></li>

    <% if (usuario.perfil === 'admin') { %>
      <li class="nav-item"><a class="nav-link" href="/usuarios">Usuários</a></li>
    <% } %>
  </ul>
  <span class="navbar-text me-3"><%= usuario.nome %> (<%= usuario.perfil %>)</span>
  <a class="btn btn-outline-light btn-sm" href="/logout">Sair</a>
</nav>
<% } %>
<main class="container mt-4">